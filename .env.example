# Supabase Credentials (Dashboard -> Project Settings -> API)
# These are SAFE to expose to the browser (VITE_* prefix) — RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# R2 credentials are NEVER put in .env — they live server-side only:
#   supabase secrets set R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_ENDPOINT=... R2_BUCKET_NAME=... R2_PUBLIC_URL=... SUPABASE_SERVICE_ROLE_KEY=...
